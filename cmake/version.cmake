# Writes amped2_version.c: the build string the game prints first in its log
# and shows on the F3 overlay, e.g. "amped2=760b799 xboxrecomp=a108cfa".
#
#   cmake -DSRC=<amped2 dir> -DTOOLKIT=<xboxrecomp dir> -DOUT=<file> -P version.cmake
#
# Each repo is its short commit, with "+modified" when tracked files differ
# from it (the same form as installer/build.ps1's manifest.txt). A player's
# install has no .git: the sources come from the installer, so the commits are
# read from the manifest.txt it unpacks next to amped2\ and xboxrecomp\.
# The file is rewritten only when the string changes, so an unchanged build
# recompiles nothing.

function(repo_version dir key out)
    set(v "")
    find_package(Git QUIET)
    if(GIT_FOUND AND EXISTS "${dir}/.git")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" rev-parse --short HEAD
                        OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE
                        RESULT_VARIABLE rc ERROR_QUIET)
        if(rc EQUAL 0 AND hash)
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" status --porcelain --untracked-files=no
                            OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            set(v "${hash}")
            if(dirty)
                set(v "${hash}+modified")
            endif()
        endif()
    endif()
    if(NOT v AND EXISTS "${dir}/../manifest.txt")
        file(STRINGS "${dir}/../manifest.txt" lines REGEX "^${key}=")
        if(lines)
            list(GET lines 0 line)
            string(REGEX REPLACE "^${key}=" "" v "${line}")
        endif()
    endif()
    if(NOT v)
        set(v "unknown")
    endif()
    set(${out} "${v}" PARENT_SCOPE)
endfunction()

repo_version("${SRC}" amped2 a)
repo_version("${TOOLKIT}" xboxrecomp x)
set(text "/* Generated by cmake/version.cmake at build time; do not edit. */\nconst char amped2_build_version[] = \"amped2=${a} xboxrecomp=${x}\";\n")

set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()

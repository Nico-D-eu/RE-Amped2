{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(cmake *)",
      "PowerShell(py -3 *)",
      "PowerShell(.\\tools\\regen.ps1*)",
      "PowerShell(.\\tools\\diag.ps1*)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(git -C * push)",
      "PowerShell(git -C * push *)"
    ],
    "additionalDirectories": [
      "../xboxrecomp"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Never push to a git remote (git push, gh repo sync, pushing tags, or any other way of publishing local commits). Local commits are allowed."
    ]
  }
}
